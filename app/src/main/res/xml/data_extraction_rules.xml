<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. Downloaded episodes live in no_backup; their index is useless without them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="exoplayer_internal.db" />
        <exclude domain="database" path="exoplayer_internal.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="exoplayer_internal.db" />
        <exclude domain="database" path="exoplayer_internal.db-journal" />
    </device-transfer>
</data-extraction-rules>
